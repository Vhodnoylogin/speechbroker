#pragma once

// GENERATED by CMake out of config/envoy.default.json. Editing it by hand is
// pointless: the next build overwrites it. Edit the settings file instead.
//
// The built-in set exists not for the sake of constants in the code but for the
// exact opposite: the plugin makes the settings file out of it on the first
// launch, and from then on the values are visible to the user and edited by them.

namespace Envoy
{
	inline constexpr const char* kDefaultConfigJson = R"ENVOYJSON(@ENVOY_DEFAULT_JSON@)ENVOYJSON";
}
