#pragma once

// СГЕНЕРИРОВАНО CMake из config/envoy.default.json. Править вручную нельзя:
// изменения будут затёрты при следующей сборке. Правь исходный файл настроек.
//
// Встроенный набор существует не ради констант в коде, а ровно наоборот: из него
// плагин создаёт файл настроек при первом запуске, и дальше значения видны
// пользователю и правятся им.

namespace Envoy
{
	inline constexpr const char* kDefaultConfigJson = R"ENVOYJSON(@ENVOY_DEFAULT_JSON@)ENVOYJSON";
}
