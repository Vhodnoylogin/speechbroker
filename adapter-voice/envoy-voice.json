{
  "_": "Настройки адаптера. Служба здесь одна и своя - она владеет микрофоном и едет внутри этого же мода. Моделей здесь нет: каждая приходит своим модом и кладёт листок в папку models рядом с этим файлом.",

  "adapter": {
    "id": "voice",
    "name": "Голосовые модели"
  },

  "service": {
    "url": "http://127.0.0.1:8931",
    "listenTimeoutSec": 30,
    "autoStart": {
      "enabled": true,
      "exec": "service/run.cmd",
      "args": [],
      "workingDir": "service",
      "waitSec": 240,
      "pollSec": 1,
      "parentPidArg": "--parent-pid"
    }
  },

  "speakModel": "",

  "correlateMs": 2500,
  "retryDelayMs": 2000,
  "healthTimeoutSec": 2,
  "listenGraceSec": 10,
  "idleSleepMs": 1000,
  "sayTimeoutSec": 120,
  "idMapLimit": 256
}
